(footprint "MICROFC-60035-SMT" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "onsemi MicroFC-60035-SMT SiPM, 7x7 mm, 4 corner terminals. Pads 2x2 mm centred on the package corners, as on the CosmicWatch v3X SiPM board (hand solderable). Pin 5 (centre paddle) intentionally has no pad: onsemi recommends leaving it unsoldered. Keep exposed copper away from the centre of the package.")
