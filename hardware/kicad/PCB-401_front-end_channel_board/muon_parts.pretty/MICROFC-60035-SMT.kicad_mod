  (fp_line (start -3.62 -2.2) (end -3.62 2.2) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start 3.62 -2.2) (end 3.62 2.2) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_circle (center -3.5 5.2) (end -3.5 5.35) (stroke (width 0.3) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_rect (start -4.75 -4.75) (end 4.75 4.75) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_line (start -3.5 -3.5) (end 3.5 -3.5) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 3.5 -3.5) (end 3.5 3.5) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 3.5 3.5) (end -2.8 3.5) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
